# Copy this file to `.env` and adjust for your machine.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here - everything in this file ships to the client.

# Base URL the app prefixes onto every backend request.
# Leave empty in development so requests stay relative and go through the
# Vite dev proxy below. Set it to the full backend origin (e.g.
# https://api.example.com) for builds that are served without the proxy.
VITE_BACKEND_BASE=

# Where the Vite dev server forwards API requests (dev only, not bundled).
VITE_BACKEND_PROXY_TARGET=http://localhost:3000

# Port the Vite dev server listens on.
VITE_DEV_PORT=5173
